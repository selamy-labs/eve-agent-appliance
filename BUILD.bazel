load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")
load("@eve_agent_appliance_npm//:defs.bzl", "npm_link_all_packages")
load(
    "//appliance:defs.bzl",
    "agent_appliance",
    "appliance_oci_image",
    "capability_digest_evidence",
    "exec_binding",
    "in_process_binding",
)

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

js_library(
    name = "generator_lib",
    srcs = [
        "src/canonical-json.mjs",
        "src/generate.mjs",
    ],
    data = [":node_modules/yaml"],
)

js_binary(
    name = "appliance_generator",
    data = [
        ":generator_lib",
        ":node_modules/yaml",
    ],
    entry_point = "src/generate.mjs",
)

js_library(
    name = "digest_evidence_lib",
    srcs = ["src/digest-evidence.mjs"],
    deps = [":generator_lib"],
)

js_binary(
    name = "capability_digest_generator",
    data = [":digest_evidence_lib"],
    entry_point = "src/digest-evidence.mjs",
)

js_test(
    name = "generator_test",
    data = [
        ":generator_lib",
        ":node_modules/ajv",
        ":node_modules/yaml",
        "schema/eve-agent-appliance-v1alpha1.schema.json",
        "schema/selamy-exec-v1.schema.json",
        "test/fixtures/nova.yaml",
    ],
    entry_point = "test/generate.test.mjs",
)

js_test(
    name = "actions_cache_cleanup_test",
    data = [
        ".github/workflows/actions-cache-24h.yaml",
        ".github/workflows/ci.yaml",
        "scripts/actions-cache-cleanup.mjs",
    ],
    entry_point = "test/actions-cache-cleanup.test.mjs",
)

js_test(
    name = "digest_evidence_test",
    data = [
        ":digest_evidence_lib",
        ":generator_lib",
    ],
    entry_point = "test/digest-evidence.test.mjs",
)

sh_binary(
    name = "fixture_eve_runtime",
    srcs = ["test/fixtures/eve-runtime.sh"],
)

sh_binary(
    name = "fixture_price_normalizer",
    srcs = ["test/fixtures/price-normalizer.sh"],
    data = ["test/fixtures/price-normalizer-data.txt"],
)

in_process_binding(
    name = "fixture_eve_binding",
    logical_name = "eve",
    target = ":fixture_eve_runtime",
)

exec_binding(
    name = "fixture_price_normalizer_binding",
    logical_name = "price-normalizer",
    target = ":fixture_price_normalizer",
)

agent_appliance(
    name = "example_appliance",
    agent_name = "nova",
    manifest = "test/fixtures/nova.yaml",
    bindings = {
        "eve": ":fixture_eve_binding",
        "price-normalizer": ":fixture_price_normalizer_binding",
    },
)

appliance_oci_image(
    name = "example_image",
    appliance = ":example_appliance",
    architecture = "amd64",
    os = "linux",
    runtime_layer = ":example_appliance_runtime_layer",
)

capability_digest_evidence(
    name = "example_capability_digest",
    image = ":example_image",
)

sh_test(
    name = "bazel_rule_test",
    srcs = ["test/bazel-rule-test.sh"],
    data = [
        ":example_appliance_binding",
        ":example_appliance_catalog",
        ":example_appliance_manifest",
        ":example_capability_digest",
    ],
)

exports_files([
    "schema/eve-agent-appliance-v1alpha1.schema.json",
    "schema/selamy-exec-v1.schema.json",
])

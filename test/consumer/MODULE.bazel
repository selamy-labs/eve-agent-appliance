module(
    name = "eve_agent_appliance_consumer",
    version = "0.0.0",
)

bazel_dep(name = "eve_agent_appliance", version = "0.1.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_oci", version = "2.3.0")

local_path_override(
    module_name = "eve_agent_appliance",
    path = "../..",
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "consumer_alpine",
    digest = "sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1",
    image = "docker.io/library/alpine",
    platforms = ["linux/amd64"],
)
use_repo(oci, "consumer_alpine", "consumer_alpine_linux_amd64")
